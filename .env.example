# Скопіюйте у .env і змініть паролі
POSTGRES_USER=skyguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=skyguard
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Повний DSN має пріоритет над POSTGRES_* (зручно для локального запуску без Docker)
# DATABASE_URL=postgresql+psycopg://skyguard:change-me@localhost:5432/skyguard

APP_ENV=dev
LOG_LEVEL=INFO

# Ключ підпису JWT. Для dev є значення за замовчуванням; поза dev задати обов'язково:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Адреси фронтенду, яким дозволено звертатися до API з браузера (через кому)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://localhost:8080

# Версія тексту політики, яку фіксує запис згоди
CONSENT_POLICY_VERSION=1.0

# Правила якості даних (SG-2): DQ-1 радіус, DQ-2 свіжість.
# Ті самі 100 м і 30 хв закріплені CHECK-обмеженнями в БД: змінювати лише разом з міграцією.
DQ_MAX_DISTANCE_M=100
DQ_MAX_AGE_MIN=30
