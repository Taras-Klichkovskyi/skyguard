    "/api/v1/shelters": {
      "get": {
        "tags": [
          "shelters"
        ],
        "summary": "List Shelters",
        "description": "Публічний реєстр укриттів (клас PUBLIC). Автентифікація не потрібна.",
        "operationId": "list_shelters_api_v1_shelters_get",
        "parameters": [
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Вікно мапи: min_lon,min_lat,max_lon,max_lat",
              "examples": [
                "23.9,49.78,24.1,49.9"
              ],
              "title": "Bbox"
            },
            "description": "Вікно мапи: min_lon,min_lat,max_lon,max_lat"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
