                  "$ref": "#/components/schemas/ShelterStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Лише з цим статусом",
              "title": "Status"
            },
            "description": "Лише з цим статусом"
          },
          {
            "name": "ramp",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
